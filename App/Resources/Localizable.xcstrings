    "iOS показывает на экране блокировки либо переключение треков, либо перемотку — обе пары кнопок сразу недоступны.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows either track switching or skipping on the Lock Screen — both pairs of buttons can’t be shown at once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS показывает на экране блокировки либо переключение треков, либо перемотку — обе пары кнопок сразу недоступны."
          }
        }
      }
    },
    "«%@» — не аудиофайл.": {
      "extractionState": "manual",
